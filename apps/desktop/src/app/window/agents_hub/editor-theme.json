{
  "_comment": "Token colours for the Agents Hub file editor: Monaco's built-in vs-dark and vs themes, which the React Hub editor used, written in the Zed highlight-theme shape gpui-component parses (agents_hub/editor.rs). Monaco colours brackets by nesting depth; a tree-sitter theme has one bracket colour, so brackets take Monaco's first pair colour.",
  "dark": {
    "name": "Monaco vs-dark",
    "appearance": "dark",
    "style": {
      "syntax": {
        "attribute": { "color": "#9cdcfe" },
        "boolean": { "color": "#569cd6" },
        "comment": { "color": "#6a9955" },
        "comment.doc": { "color": "#6a9955" },
        "constant": { "color": "#569cd6" },
        "constructor": { "color": "#4ec9b0" },
        "embedded": { "color": "#d4d4d4" },
        "emphasis": { "font_style": "italic" },
        "emphasis.strong": { "font_weight": 700 },
        "enum": { "color": "#4ec9b0" },
        "function": { "color": "#dcdcaa" },
        "hint": { "color": "#6a9955" },
        "keyword": { "color": "#569cd6" },
        "label": { "color": "#9cdcfe" },
        "link_text": { "color": "#ce9178" },
        "link_uri": { "color": "#ce9178" },
        "number": { "color": "#b5cea8" },
        "operator": { "color": "#d4d4d4" },
        "predictive": { "color": "#808080" },
        "preproc": { "color": "#569cd6" },
        "primary": { "color": "#d4d4d4" },
        "property": { "color": "#9cdcfe" },
        "punctuation": { "color": "#d4d4d4" },
        "punctuation.bracket": { "color": "#ffd700" },
        "punctuation.delimiter": { "color": "#d4d4d4" },
        "punctuation.list_marker": { "color": "#569cd6" },
        "punctuation.special": { "color": "#569cd6" },
        "string": { "color": "#ce9178" },
        "string.escape": { "color": "#d7ba7d" },
        "string.regex": { "color": "#d16969" },
        "string.special": { "color": "#ce9178" },
        "string.special.symbol": { "color": "#ce9178" },
        "tag": { "color": "#569cd6" },
        "tag.doctype": { "color": "#569cd6" },
        "text.code.span": { "color": "#ce9178" },
        "text.literal": { "color": "#ce9178" },
        "title": { "color": "#569cd6", "font_weight": 700 },
        "type": { "color": "#4ec9b0" },
        "variable": { "color": "#9cdcfe" },
        "variable.special": { "color": "#569cd6" },
        "variant": { "color": "#4ec9b0" }
      }
    }
  },
  "light": {
    "name": "Monaco vs",
    "appearance": "light",
    "style": {
      "syntax": {
        "attribute": { "color": "#e50000" },
        "boolean": { "color": "#0000ff" },
        "comment": { "color": "#008000" },
        "comment.doc": { "color": "#008000" },
        "constant": { "color": "#0000ff" },
        "constructor": { "color": "#267f99" },
        "embedded": { "color": "#000000" },
        "emphasis": { "font_style": "italic" },
        "emphasis.strong": { "font_weight": 700 },
        "enum": { "color": "#267f99" },
        "function": { "color": "#795e26" },
        "hint": { "color": "#008000" },
        "keyword": { "color": "#0000ff" },
        "label": { "color": "#0451a5" },
        "link_text": { "color": "#a31515" },
        "link_uri": { "color": "#a31515" },
        "number": { "color": "#098658" },
        "operator": { "color": "#000000" },
        "predictive": { "color": "#808080" },
        "preproc": { "color": "#0000ff" },
        "primary": { "color": "#000000" },
        "property": { "color": "#0451a5" },
        "punctuation": { "color": "#000000" },
        "punctuation.bracket": { "color": "#0431fa" },
        "punctuation.delimiter": { "color": "#000000" },
        "punctuation.list_marker": { "color": "#0451a5" },
        "punctuation.special": { "color": "#000000" },
        "string": { "color": "#a31515" },
        "string.escape": { "color": "#ee0000" },
        "string.regex": { "color": "#811f3f" },
        "string.special": { "color": "#a31515" },
        "string.special.symbol": { "color": "#a31515" },
        "tag": { "color": "#800000" },
        "tag.doctype": { "color": "#800000" },
        "text.code.span": { "color": "#a31515" },
        "text.literal": { "color": "#a31515" },
        "title": { "color": "#800000", "font_weight": 700 },
        "type": { "color": "#267f99" },
        "variable": { "color": "#001080" },
        "variable.special": { "color": "#0000ff" },
        "variant": { "color": "#267f99" }
      }
    }
  }
}
