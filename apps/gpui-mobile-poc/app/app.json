{
  "expo": {
    "name": "GPUI POC",
    "slug": "ghostex-gpui-mobile-poc",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#181818",
    "newArchEnabled": true,
    "plugins": [
      "expo-status-bar",
      "./plugins/withLoopbackCleartext.js",
      "./plugins/withSceneLifecycle.js"
    ],
    "ios": {
      "bundleIdentifier": "dev.ghostex.gpuipoc",
      "supportsTablet": true,
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "dev.ghostex.gpuipoc",
      "predictiveBackGestureEnabled": false
    }
  }
}
